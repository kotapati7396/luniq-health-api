# --- OpenAI ---
OPENAI_API_KEY=sk-your-key-here
MODEL_NAME=gpt-5-nano-2025-08-07

# --- API auth: clients must send this in the X-API-Key header ---
# Leave blank ONLY for local development. Set a strong random value in production.
API_KEY=change-me-to-a-long-random-value

# --- Memory ---
DB_PATH=luniq_memory.db
MAX_TURNS=5

# --- Rate limiting ---
RATE_LIMIT_PER_MINUTE=10

# --- CORS: comma-separated list of allowed origins, or * for all ---
ALLOWED_ORIGINS=*

# --- Misc ---
ENVIRONMENT=production
LOG_LEVEL=INFO
